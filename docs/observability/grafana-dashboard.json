{
  "annotations": {
    "list": []
  },
  "description": "Starter Grafana dashboard for wg-manager (Phase 3a cycle 1). Covers HTTP request rate + latency, Celery task throughput + duration, Vault round-trip latency, and cert lifecycle events. Import via Grafana UI: Dashboards → Import → Upload JSON file.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(wg_manager_http_requests_total[5m]))",
          "legendFormat": "status {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate by status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(wg_manager_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{path}}",
          "refId": "A"
        }
      ],
      "title": "HTTP request p95 latency by route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (task_name, state) (rate(wg_manager_celery_tasks_total[5m]))",
          "legendFormat": "{{task_name}} {{state}}",
          "refId": "A"
        }
      ],
      "title": "Celery task throughput by name + state",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, task_name) (rate(wg_manager_celery_task_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{task_name}}",
          "refId": "A"
        }
      ],
      "title": "Celery task p95 duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, engine, operation) (rate(wg_manager_vault_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{engine}}/{{operation}}",
          "refId": "A"
        }
      ],
      "title": "Vault round-trip p95 latency by engine + operation",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (engine, result) (rate(wg_manager_vault_requests_total[5m]))",
          "legendFormat": "{{engine}} {{result}}",
          "refId": "A"
        }
      ],
      "title": "Vault round-trip rate by engine + result",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (cert_type) (rate(wg_manager_certs_issued_total[1h]))",
          "legendFormat": "issued {{cert_type}}",
          "refId": "A"
        },
        {
          "expr": "sum by (cert_type) (rate(wg_manager_certs_renewed_total[1h]))",
          "legendFormat": "renewed {{cert_type}}",
          "refId": "B"
        },
        {
          "expr": "sum by (cert_type) (rate(wg_manager_certs_revoked_total[1h]))",
          "legendFormat": "revoked {{cert_type}}",
          "refId": "C"
        }
      ],
      "title": "Cert lifecycle events by type",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["wg-manager", "phase-3a"],
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "wg-manager — service health (Phase 3a cycle 1)",
