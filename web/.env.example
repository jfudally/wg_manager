# ---------------------------------------------------------------------------
# wg-manager dashboard — environment template
# ---------------------------------------------------------------------------
#
# Copy to ``web/.env.local`` for local dev. The dashboard talks to the
# FastAPI control plane through a same-origin BFF proxy (the Node-runtime
# Route Handler at ``app/api/proxy/[...path]/route.ts``) so the browser
# never has to participate in the API's mTLS handshake. The Node side of
# Next.js presents the client cert; the browser sees plain HTTP on
# ``http://localhost:3100``.
#
# The four ``WG_MANAGER_API_*`` vars below are server-only and are read
# inside the Route Handler — never bundled into client JS. The
# ``NEXT_PUBLIC_WG_MANAGER_API`` var is rarely needed; leave it unset
# and the dashboard auto-uses ``/api/proxy``.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI control plane. Must include the scheme; no
# trailing slash. Production uses ``https://``; the dev path produced
# by ``wg-manager certs issue --type api`` (Phase 2d CP3.3) is the
# value below.
WG_MANAGER_API_UPSTREAM=https://127.0.0.1:8000

# Paths to the mTLS client cert, matching key, and CA bundle. The
# artefacts are minted via the CP3.3 CLI:
#
#   wg-manager operators add --cn dev-operator --role admin
#   wg-manager certs issue --type api --cn 127.0.0.1 \
#     --out-cert ../tls/server.crt --out-key ../tls/server.key \
#     --out-chain ../tls/ca-bundle.crt
#   wg-manager certs issue --type cli --cn dev-operator \
#     --out-cert ../tls/client.crt --out-key ../tls/client.key \
#     --out-chain ../tls/client.chain.crt
#
# For browser PKCS#12 import (the future "Who am I?" splash on the
# dashboard), use ``--type dashboard --out-pkcs12 ../tls/dashboard.p12``
# instead.
WG_MANAGER_API_CLIENT_CERT=../tls/client.crt
WG_MANAGER_API_CLIENT_KEY=../tls/client.key
WG_MANAGER_API_CA_BUNDLE=../tls/ca-bundle.crt

# Optional: bypass the BFF entirely (e.g. when pointing the dashboard
# at a non-mTLS staging host). Leave unset for the standard dev/prod
# path — the dashboard will route through ``/api/proxy``.
# NEXT_PUBLIC_WG_MANAGER_API=https://api.staging.example.com
