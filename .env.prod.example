# ===========================================================================
# Production .env template for `docker-compose.prod.yml`.
# ===========================================================================
#
# Copy this file to `.env.prod` and fill in real values BEFORE running
# `make prod-up`. The overlay uses Compose's `${VAR:?msg}` substitution
# on every secret, so a missing value fails loud at `compose up` time
# instead of silently defaulting to a vulnerable string.
#
# `.env.prod` is gitignored (see `.gitignore`); the example in this
# file is. Treat the populated `.env.prod` like the root of every
# secret it carries — backups encrypted, access ACL'd to your operator
# group.
# ===========================================================================

# ---------------------------------------------------------------------------
# Vault — runs in PRODUCTION mode with file storage + auto-unseal.
# ---------------------------------------------------------------------------
#
# Vault boots from `docker/vault/vault.hcl` (file storage backend +
# HTTP listener on the docker network + ui + disable_mlock). State
# persists across container restarts.
#
# The root token + 5 unseal keys are generated automatically by
# `scripts/vault_init_unseal.sh` on the FIRST `make prod-up` and
# written to `vault-init.json` in the repo root (mode 0600,
# gitignored). On every subsequent `make prod-up` the same script
# reads the file back and re-unseals Vault.
#
# **No VAULT_ROOT_TOKEN entry here** — the token is generated, not
# operator-provided. Back up `vault-init.json` alongside this file;
# losing both means losing every secret Vault holds.
#
# Optional tuning of the init shape (defaults match Vault's docs):
# VAULT_KEY_SHARES=5
# VAULT_KEY_THRESHOLD=3

# ---------------------------------------------------------------------------
# MySQL — root + application credentials.
# ---------------------------------------------------------------------------
# `MYSQL_ROOT_PASSWORD` is used only at first-boot to provision the
# `MYSQL_USER` / `MYSQL_PASSWORD` account. Rotate after provisioning
# if you don't need DBA access from inside the stack.
#
# MUST be URL-safe (no `/`, `+`, `=`, `:`, `@`, `?`, `#`, `%`, space).
# `MYSQL_APP_PASSWORD` is interpolated into `DATABASE_URL`; un-safe
# chars break SQLAlchemy's URL parser at startup. Use one of:
#   openssl rand -hex 32                      # always URL-safe
#   openssl rand -base64 24 | tr -d '/+=:@?#%'  # if you want base64 entropy
MYSQL_ROOT_PASSWORD=CHANGEME-strong-mysql-root-password
MYSQL_APP_PASSWORD=CHANGEME-strong-mysql-app-password

# Optional. Override only when integrating into an existing schema
# /  user-namespace convention.
# MYSQL_DATABASE=wg_manager
# MYSQL_APP_USER=wg

# ---------------------------------------------------------------------------
# Valkey (Celery broker) — AUTH password.
# ---------------------------------------------------------------------------
# Required in prod — the broker is open to anything on the docker
# network without AUTH, which is wider than you want.
#
# MUST be URL-safe (no `/`, `+`, `=`, `:`, `@`, `?`, `#`, `%`, space)
# — this value is interpolated into `redis://:${pw}@valkey:6379/0`
# and kombu's URL parser rejects un-safe chars at worker startup.
# Use `openssl rand -hex 32` for guaranteed-safe entropy.
VALKEY_PASSWORD=CHANGEME-strong-valkey-password

# ---------------------------------------------------------------------------
# Operator bootstrap.
# ---------------------------------------------------------------------------
# CN of the first operator the self-bootstrap registers and mints a
# CLI client cert for. The dashboard's BFF proxy uses that same cert
# to call the API, and an operator can curl the API directly with it
# too. Required — Phase 2 (`bootstrap-app`) fails fast if unset.
# Strong convention: use a real DNS-style identity (`ops@yourbox.com`
# or `ops@yourbox.local`) so the cert subject reads sanely in audit
# logs. The CN can be rotated later by adding a new operator + minting
# a new cert.
BOOTSTRAP_OPERATOR_CN=ops@CHANGEME.example

# Operator role at register time. `admin` (the default) gets full
# CRUD on every resource — appropriate for a single-team prod box.
# Set to `operator` or `auditor` if the first operator is a service
# account with narrower needs.
# BOOTSTRAP_OPERATOR_ROLE=admin

# ---------------------------------------------------------------------------
# API server cert subject.
# ---------------------------------------------------------------------------
# CN baked into the API server cert that uvicorn presents on the
# public 443 listener. Should match the public DNS name operators use
# to reach the API. The default (`localhost`) is fine for a single-
# host demo on this box; production must override.
# API_SERVER_CN=yourbox.example.com

# Comma-separated Subject Alternative Names on the API server cert.
# The defaults cover the in-container healthcheck (`localhost` +
# `127.0.0.1`) and the compose-network hostname (`api`). Add your
# public DNS name to keep the curl smoke flow honest:
#   API_SERVER_SANS=localhost,127.0.0.1,api,yourbox.example.com
# API_SERVER_SANS=localhost,127.0.0.1,api

# ---------------------------------------------------------------------------
# Image tag — both API/worker (`wg-manager`) and dashboard
# (`wg-manager-web`). Defaults to the in-tree `:prod` tags built by
# the overlay's `build:` blocks. Override to pull a published image
# from GHCR for reproducible deploys:
#
#   WG_MANAGER_IMAGE=ghcr.io/jfudally/wg-manager:v0.4.0
#   WG_MANAGER_WEB_IMAGE=ghcr.io/jfudally/wg-manager-web:v0.4.0
# ---------------------------------------------------------------------------
# WG_MANAGER_IMAGE=wg-manager:prod
# WG_MANAGER_WEB_IMAGE=wg-manager-web:prod

# ---------------------------------------------------------------------------
# WireGuard defaults — the CIDR + UDP port a `POST /servers` payload
# inherits when those fields are omitted (and the value the
# dashboard's "New server" form pre-fills). The code defaults
# (`10.9.0.0/24` + `51820`) are fine for a fresh deploy; set these
# when those collide with an existing route on the host's network or
# when running multiple wg-manager stacks on overlapping VPN address
# space.
# ---------------------------------------------------------------------------
# DEFAULT_SUBNET=10.9.0.0/24
# DEFAULT_WG_PORT=51820

# ---------------------------------------------------------------------------
# SSH-CA role allowlists.
# ---------------------------------------------------------------------------
# Comma-separated principals the Vault user-cert role accepts. The
# code default covers the common cloud-image accounts so a fresh
# `make prod-up` against a stock AMI / Azure image works without
# editing anything. Extend this when wg-manager dials a target as
# a non-standard user (custom-named login account, a long-lived
# operator UID, etc.) — Vault otherwise refuses to sign a user cert
# for a principal it hasn't been told about, with the error:
#
#   "<user> is not a valid value for valid_principals"
#
# After editing, re-run the substrate bootstrap so the role upserts
# with the new allowlist:
#
#   docker compose --env-file .env.prod \
#       -f docker-compose.yml -f docker-compose.prod.yml \
#       up bootstrap-substrate
#
# SSH_CA_VAULT_ALLOWED_USERS=root,ubuntu,ec2-user,azureuser,debian,admin

# Comma-separated domain list the host-cert role accepts as
# principals. Empty (the default) means "any principal" so bootstrap
# works against IP-only fleets and internal DNS uniformly. Production
# deployments with stable DNS can tighten to a real domain list
# (e.g. `prod.example.com`) for defence in depth.
# SSH_CA_VAULT_ALLOWED_HOST_DOMAINS=

# ---------------------------------------------------------------------------
# Public-ingress binding.
# ---------------------------------------------------------------------------
# `*_BIND_ADDR` defaults to 0.0.0.0 (all interfaces); set to a specific
# IP on a multi-homed box.
# `*_BIND_PORT` defaults are the canonical ports (443 for HTTPS, 3000
# for Next.js). Override when running multiple stacks on one host or
# fronting the API behind another reverse proxy that owns 443.
# WG_MANAGER_API_BIND_ADDR=0.0.0.0
# WG_MANAGER_API_BIND_PORT=443
# WG_MANAGER_WEB_BIND_ADDR=0.0.0.0
# WG_MANAGER_WEB_BIND_PORT=3000

# ---------------------------------------------------------------------------
# Tracing (Phase 3a cycle 2). Defaults to `none` so an operator
# without an OTLP collector pays nothing. `otlp-http` is the
# production exporter — point OTEL_EXPORTER_OTLP_ENDPOINT at a local
# collector that fans out to Jaeger / Tempo / Honeycomb.
# ---------------------------------------------------------------------------
# OTEL_EXPORTER=otlp-http
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=wg-manager
