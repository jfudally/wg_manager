DATABASE_URL=mysql+pymysql://wg:wg@localhost:3306/wg_manager
BIND_HOST=127.0.0.1
BIND_PORT=8000
DEFAULT_SUBNET=10.8.0.0/24
DEFAULT_WG_PORT=51820
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Comma-separated list of origins the API will allow via CORS (browser
# clients only). The Next.js dashboard in web/ runs on :3000 by default.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Encryption at rest (Phase 2b — wg_manager.crypto)
# ---------------------------------------------------------------------------

# Which backend wraps secret material before it lands in MySQL.
# - "local": Fernet keyed from CRYPTO_LOCAL_DEV_KEY below. Dev / tests only.
# - "vault": HashiCorp Vault Transit. Production.
CRYPTO_BACKEND=local

# Required when CRYPTO_BACKEND=local. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRYPTO_LOCAL_DEV_KEY=

# Vault connection. Falls back to the standard VAULT_ADDR / VAULT_TOKEN
# env vars so the Vault CLI and wg-manager read the same values.
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=dev-only-root

# Transit key name + mount path. The key must exist and must have been
# created with derived=true so the per-row context binding actually
# affects the derived encryption key — see docs/vault-cookbook.md §1.
CRYPTO_VAULT_TRANSIT_KEY=wg-manager
CRYPTO_VAULT_TRANSIT_MOUNT=transit

# ---------------------------------------------------------------------------
# SSH CA (Phase 2c — wg_manager.ssh_ca)
# ---------------------------------------------------------------------------

# Which backend signs short-lived SSH user/host certificates.
# - "local": in-process throwaway ed25519 CA. Dev / tests only.
# - "vault": HashiCorp Vault SSH secrets engine. Production.
SSH_CA_BACKEND=local

# Optional. When SSH_CA_BACKEND=local, an OpenSSH ed25519 private-key PEM
# pinning the CA across restarts. Leaving it unset auto-generates a fresh
# CA on every process start (fine for tests, brittle for dev workflows
# that need a stable CA pubkey on disk). Never set this in production.
# SSH_CA_LOCAL_DEV_PEM=

# Vault SSH secrets engine mount + role names. Created by
# `make ssh-ca-bootstrap` (see docs/vault-cookbook.md §7).
SSH_CA_VAULT_MOUNT=ssh
SSH_CA_VAULT_USER_ROLE=wg-manager-provision
SSH_CA_VAULT_HOST_ROLE=wg-manager-hosts

# Comma-separated principals the Vault user-cert role accepts. The
# default covers the common cloud-image accounts so the first
# `wg-manager ssh migrate-to-ca` against a stock AMI/Azure VM works
# without re-bootstrapping. Tighten this in production.
SSH_CA_VAULT_ALLOWED_USERS=root,ubuntu,ec2-user,azureuser,debian,admin

# Comma-separated domains the Vault host-cert role accepts. Empty
# means "any principal" (allowed_domains='*', allow_bare_domains=true,
# allow_subdomains=true) — appropriate for IP-only fleets and dev.
# Set to a real domain list (e.g. "prod.example.com") once you have
# stable DNS.
SSH_CA_VAULT_ALLOWED_HOST_DOMAINS=

# Phase 2c checkpoint 2 — DEPRECATED since CP4.1 (2026-05-27). The
# Celery task layer now routes per-row off `SSHKey.mode` (Alembic 0007);
# this env var is no longer consulted on any code path. Left here so a
# pre-CP4.1 .env that still sets it doesn't trip pydantic's `extra` mode.
# To flip a row from legacy stored-key auth to CA-minted cert auth, use
# the migration CLI shipped in CP4.2:
#   wg-manager ssh migrate-to-ca <sshkey_id>
# CP4.4 will remove this setting outright once every row is `mode='ca'`.
SSH_AUTH_MODE=legacy

# TTL the task layer requests when minting a user cert. 5 minutes is long
# enough for one provisioning round-trip, short enough that a leaked cert
# dies on its own. Must be <= the Vault role's max_ttl.
SSH_USER_CERT_TTL_SECONDS=300

# Phase 2c checkpoint 3 — TTL for host certs installed during CA-mode
# provisioning. 24 h matches the default `host_default_ttl` set by
# `VaultSSHCA.bootstrap`. Operators on a tighter cadence can dial this
# down and pair it with a scheduled
# `POST /servers/{id}/rotate-host-cert` call to keep certs fresh.
SSH_HOST_CERT_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# PKI (Phase 2d — wg_manager.pki)
# ---------------------------------------------------------------------------

# Which X.509 backend wraps leaf-cert issuance for the wg-manager API
# listener (CP2), MySQL boundary (CP4), and operator client certs (CP3).
# - "local": in-process root + intermediate via the `cryptography`
#   library. Dev / tests only — CA private keys live in process memory.
# - "vault": HashiCorp Vault PKI secrets engine. Production.
PKI_BACKEND=local

# Optional. When PKI_BACKEND=local, pinning all four PEMs gives you a
# stable hierarchy across restarts (the API and Celery worker each
# build a backend at import time; without the pin they end up with
# different roots and mTLS verification breaks on the second hop).
# Pin all four or none — partial pins are rejected. Never set in production.
# PKI_LOCAL_DEV_ROOT_PEM=
# PKI_LOCAL_DEV_ROOT_KEY_PEM=
# PKI_LOCAL_DEV_INT_PEM=
# PKI_LOCAL_DEV_INT_KEY_PEM=

# Vault PKI mount paths. Convention: `pki` for the 10y root, `pki_int`
# for the 5y intermediate (the surface wg-manager actually issues
# leaves from). `make pki-bootstrap` creates both idempotently — see
# docs/vault-cookbook.md §4.
PKI_VAULT_ROOT_MOUNT=pki
PKI_VAULT_INT_MOUNT=pki_int

# Vault PKI role names. Created on the intermediate mount by
# `make pki-bootstrap`. The server role carries the `serverAuth` EKU
# (for the API listener + MySQL server cert); the client role carries
# `clientAuth` (for operator + CLI + dashboard client certs).
PKI_VAULT_SERVER_ROLE=wg-manager-server
PKI_VAULT_CLIENT_ROLE=wg-manager-client

# Comma-separated domains the *server* role accepts as SANs. Empty
# (the default) is interpreted as "any name" — appropriate for IP-only
# fleets and the first `make pki-bootstrap` run. Production with stable
# DNS should set this to the real domain list (e.g.
# `wg.local,vpn.example.com`). The client role is always permissive so
# operator CNs like `ops@wg.local` work.
PKI_VAULT_ALLOWED_DOMAINS=

# ---------------------------------------------------------------------------
# TLS / mTLS (Phase 2d CP2 — wg_manager.auth)
# ---------------------------------------------------------------------------

# When `true`, every non-OPTIONS request must present a client cert
# (the CP2 MTLSAuthMiddleware 401s otherwise). The default is `false`
# so the test suite stays hermetic; **production must set this to
# `true`** alongside the cert paths below.
TLS_REQUIRED=false

# Paths to the PEM files uvicorn passes via --ssl-certfile,
# --ssl-keyfile, and --ssl-ca-certs. `make run` (which delegates to
# `python -m wg_manager`) refuses to start unless all three are set.
#
# Dev path (Phase 2d CP3.3):
#   wg-manager operators add --cn dev-operator --role admin
#   wg-manager certs issue --type api --cn 127.0.0.1 \
#     --out-cert tls/server.crt --out-key tls/server.key \
#     --out-chain tls/ca-bundle.crt
#   wg-manager certs issue --type cli --cn dev-operator \
#     --out-cert tls/client.crt --out-key tls/client.key \
#     --out-chain tls/client.chain.crt
#   export TLS_REQUIRED=true \
#          TLS_CERT_PEM=tls/server.crt \
#          TLS_KEY_PEM=tls/server.key \
#          TLS_CA_BUNDLE_PEM=tls/ca-bundle.crt
#   make run
#
# Production path: bootstrap Vault PKI then mint via the CP3.3 CLI
# (`make pki-bootstrap` followed by `wg-manager certs issue --type
# api/mysql/cli/dashboard`).
# TLS_CERT_PEM=
# TLS_KEY_PEM=
# TLS_CA_BUNDLE_PEM=

# ---------------------------------------------------------------------------
# Operator registry (Phase 2d CP3.2 — wg_manager.auth)
# ---------------------------------------------------------------------------

# CN of the operator the middleware auto-registers the first time it
# sees that CN on a request. Solves the chicken-and-egg gap CP3.1
# left: with mTLS enforced and the `operator` table empty, there is
# no authenticated path to insert the first row. Set this on a fresh
# install, send the first request from the matching client cert (the
# row is created + admitted in the same transaction), then unset (or
# rotate) once additional operators are added through the dashboard /
# CLI follow-on. Unset (default) disables the path — every unknown
# CN is a 401.
# AUTH_BOOTSTRAP_OPERATOR_CN=ops@wg.local

# Role assigned to the bootstrap operator at self-register time.
# Defaults to `admin` because the bootstrap row's whole purpose is
# registry management (adding the rest of the team). Production
# deploys can pin a different value (`operator` / `auditor`) if the
# first cert belongs to a service account that needs only read
# access. Ignored when AUTH_BOOTSTRAP_OPERATOR_CN is unset.
# AUTH_BOOTSTRAP_OPERATOR_ROLE=admin
