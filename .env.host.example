# ===========================================================================
# Per-host settings for a primary/standby pair (Phase 3d cycle 5b).
# ===========================================================================
#
# Copy to .env.host on EACH host. It's gitignored, and `make host-export`
# never bundles it, because unlike .env.prod it differs between the two
# hosts. The Makefile layers it after .env.prod, so its values win.
# Single-host installs don't need this file.
#
# docs/runbooks/standby-replication.md walks through the setup.
# ===========================================================================

# primary | standby
#   primary — runs the full stack (`make prod-up`); refuses `standby-up`.
#   standby — runs the MySQL replica only (`make standby-up`); refuses
#             `prod-up`, so two beats never race host-cert renewals.
# `make failover` (cycle 5d) flips this on promotion.
WG_MANAGER_ROLE=primary

# Address this host's MySQL is published on, so the other host can
# replicate from it. Use the private/VPN address, never a public one:
# Docker-published ports bypass ufw. Leave unset to keep the
# single-host default of 127.0.0.1.
MYSQL_BIND_ADDR=10.0.0.1
