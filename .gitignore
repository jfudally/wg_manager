# --- Secrets / local config -------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
!.env.example

# Dev TLS material written by `wg-manager certs issue` (Phase 2d CP3.3+).
# Throwaway certs/keys for the local API listener / MySQL — never commit.
# Phase 2d CP4.2 keeps an empty ``tls/mysql/`` directory checked in so the
# docker-compose bind mount has a directory to point at on a fresh clone.
# Use ``tls/*`` (not ``tls/``) so git still recurses into the directory
# and the ``!`` re-include below actually matches.
tls/*
!tls/mysql/
tls/mysql/*
!tls/mysql/.gitkeep

# --- Build artefacts --------------------------------------------------------
*.log
*.sqlite
*.sqlite3

# Phase 2e cycle 2: Vault raft snapshots written by `make backup-vault`.
# Snapshots may include sensitive Vault state — never commit.
backups/

# Phase 2e cycle 4: SOC 2 evidence packs written by `make evidence` /
# `wg-manager evidence pack`. Each pack carries the cert + operator
# inventory, audit events, and a Vault audit log slice — never commit.
evidence/
